{
  "name": "inmoment-services",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "payload generate:importmap && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/inquiry.test.ts tests/submission.test.ts tests/cms.test.ts",
    "build:preview": "node scripts/build-preview.mjs",
    "format": "prettier --write app components content lib tests next.config.ts tsconfig.json",
    "admin:setup": "tsx scripts/cms-setup.ts",
    "blog:check": "node scripts/blog-check.mjs",
    "cms:import": "tsx scripts/cms-import.ts",
    "cms:setup": "tsx scripts/cms-setup.ts",
    "payload": "payload",
    "cms:migrate": "payload migrate",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@next/env": "^16.3.6",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.14.2",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.4",
    "unified": "^11.0.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  }
}
