# Canonical origin, also used for form and CMS origin checks.
NEXT_PUBLIC_SITE_URL=https://inmomentservices.com
NEXT_PUBLIC_PREVIEW=0

# Native Payload CMS. Generate secrets and your first user with npm run cms:setup.
PAYLOAD_SECRET=
# Use an absolute path on your Pi and back up the database + media together.
DATABASE_URI=file:./data/cms/inmoment.db
# CMS_MEDIA_DIR=/var/lib/inmoment/media

# Independent InMoment automation key; keep it out of browser code.
OPENCLAW_API_KEY=
BOT_API_HOST=inmomentservices.com
# true only when all ingress is restricted to Cloudflare Tunnel.
TRUST_CLOUDFLARE=false

# Enquiries are stored in the CMS; no email provider is required.
# Newsletter is a separate optional integration.
NEXT_PUBLIC_NEWSLETTER_ENABLED=false
NEWSLETTER_WEBHOOK_URL=
FORM_WEBHOOK_TOKEN=

# Legacy import sources only. Keep the old media folder for existing cover URLs.
# BLOG_DATA_DIR=/var/lib/inmoment/blog
# INQUIRY_DATA_DIR=/var/lib/inmoment/inquiries
