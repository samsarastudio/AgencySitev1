# Canonical production origin. Set to your deployment URL for a separate public staging site.
NEXT_PUBLIC_SITE_URL=https://inmomentservices.com
# Set true ONLY after configuring and testing the corresponding server-side webhook.
NEXT_PUBLIC_FORMS_ENABLED=false
NEXT_PUBLIC_NEWSLETTER_ENABLED=false
INQUIRY_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
FORM_WEBHOOK_TOKEN=
# The static private review build sets this to 1 automatically.
NEXT_PUBLIC_PREVIEW=0

# Blog editor on the Pi. Generate password hash and session secret with npm run admin:setup.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Exact public HTTPS origin, no trailing slash. Required for production admin writes.
ADMIN_ORIGIN=https://inmomentservices.com
# Absolute persistent path on Pi is recommended; default is ./data/blog. Back up this directory.
# BLOG_DATA_DIR=/var/lib/inmoment/blog

# Bot publishing compatibility endpoint: POST /api/bot/posts
# Generate a random key of at least 32 characters. Never prefix secrets with NEXT_PUBLIC_.
OPENCLAW_API_KEY=
# Exact hostname only (no scheme, path or port).
BOT_API_HOST=inmomentservices.com
# Set true ONLY when ingress is restricted to your Cloudflare Tunnel.
TRUST_CLOUDFLARE=false
